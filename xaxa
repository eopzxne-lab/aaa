-- ============================================================
-- LÓGICA DE DETECÇÃO CORRIGIDA
-- ============================================================
local function getCharacterFromPart(part)
    local current = part
    while current and current ~= workspace do
        if current:IsA("Model") and current:FindFirstChildOfClass("Humanoid") then
            return current
        end
        current = current.Parent
    end
    return nil
end

local function isEnemy(character)
    if not character or not character.Parent then return false end
    
    local targetPlayer = Players:GetPlayerFromCharacter(character)
    
    if not targetPlayer then
        return not CONFIG.FRIENDLY_FIRE
    end

    if targetPlayer == LocalPlayer then
        return false
    end

    if CONFIG.FRIENDLY_FIRE then return true end

    if CONFIG.TEAM_CHECK and targetPlayer.Team and LocalPlayer.Team then
        if targetPlayer.Team == LocalPlayer.Team then
            return false
        end
    end
    
    return true
end

local function updateDebug(text)
    if CONFIG.SHOW_DEBUG and debugLabel then
        if debugLabel.Text ~= text then
            debugLabel.Text = "Debug: " .. text
        end
    end
end

RunService.RenderStepped:Connect(function()
    if not state.enabled then 
        stopFiring()
        return 
    end
    
    local character = LocalPlayer.Character
    local camera = workspace.CurrentCamera
    
    if not character or not camera then
        stopFiring()
        updateDebug("No Character/Camera")
        return
    end

    local humanoid = character:FindFirstChild("Humanoid")
    if not humanoid or humanoid.Health <= 0 then
        stopFiring()
        updateDebug("Dead/No Humanoid")
        return
    end

    -- Cria o Raycast partindo exatamente do centro da tela
    local viewportSize = camera.ViewportSize
    local centerScreen = Vector2.new(viewportSize.X / 2, viewportSize.Y / 2)
    local unitRay = camera:ViewportPointToRay(centerScreen.X, centerScreen.Y)
    
    local params = RaycastParams.new()
    params.FilterDescendantsInstances = {character}
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.IgnoreWater = true

    local raycastResult = workspace:Raycast(unitRay.Origin, unitRay.Direction * CONFIG.MAX_RANGE, params)
    
    local shouldFire = false
    
    if raycastResult and raycastResult.Instance then
        local hitPart = raycastResult.Instance
        local hitCharacter = getCharacterFromPart(hitPart)
        
        if hitCharacter then
            if isEnemy(hitCharacter) then
                shouldFire = true
                updateDebug("Target: " .. hitCharacter.Name)
            else
                updateDebug("Ally: " .. hitCharacter.Name)
            end
        else
            updateDebug("Blocked: " + hitPart.Name)
        end
    else
        updateDebug("Empty Space")
    end

    if shouldFire then
        -- Verifica se a arma é automática olhando o tipo de input ou se está segurando
        -- Detectamos metralhadoras mantendo o botão pressionado continuamente
        startFiring()
    else
        stopFiring()
    end
end)

