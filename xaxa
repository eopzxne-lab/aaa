-- Funções de clique corrigidas para segurar em metralhadoras
local function startFiring()
    if not state.isFiring then
        state.isFiring = true
        pcall(function()
            if mouse1press then
                mouse1press()
            elseif pressmouse1 then
                pressmouse1()
            end
        end)
    end
end

local function stopFiring()
    if state.isFiring then
        state.isFiring = false
        pcall(function()
            if mouse1release then
                mouse1release()
            elseif releasemouse1 then
                releasemouse1()
            end
        end)
    end
end

-- Função auxiliar para armas de um tiro (clique rápido contínuo)
local function clickOnce()
    pcall(function()
        if mouse1click then
            mouse1click()
        elseif clickmouse1 then
            clickmouse1()
        else
            -- Fallback caso o executor só tenha press/release
            startFiring()
            task.delay(0.05, stopFiring)
        end
    end)
end

