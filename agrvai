-- LÓGICA DE DISPARO HÍBRIDA
local function forceFire(tool)
    if not tool then return false end
    
    -- 1. Tenta RemoteEvents comuns
    local remoteNames = {"Fire", "Shoot", "Trigger", "FireWeapon", "Ammo_Shot"}
    for _, name in ipairs(remoteNames) do
        local rem = tool:FindFirstChild(name)
        if rem and rem:IsA("RemoteEvent") then
            rem:FireServer()
            return true
        end
    end
    
    -- 2. Tenta BindableEvents locais
    local bindableNames = {"Fire", "Shoot", "Trigger"}
    for _, name in ipairs(bindableNames) do
        local bind = tool:FindFirstChild(name)
        if bind and bind:IsA("BindableEvent") then
            bind:Fire()
            return true
        end
    end
    
    -- 3. Fallback: Simula Input via UserInputService (Mais robusto que Mouse:Click)
    -- Isso força o script da arma a "ver" que o mouse foi pressionado
    local mousePos = Vector2.new(workspace.CurrentCamera.ViewportSize.X / 2, workspace.CurrentCamera.ViewportSize.Y / 2)
    
    -- Simula o evento de mouse
    UserInputService:FireInput(Enum.UserInputType.MouseButton1, Enum.KeyCode.Unknown, true, false, nil, mousePos)
    
    -- Pequeno delay para garantir que o evento seja processado
    task.wait(0.01)
    
    return true
end

-- LÓGICA DE ALVO
local function getTarget()
    local char = LocalPlayer.Character
    if not char then return nil end
    
    local camera = workspace.CurrentCamera
    
    -- Define a origem do raycast
    local origin, direction
    if CONFIG.CENTER_CROSSHAIR then
        -- Usa o centro exato da tela
        local center = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
        local ray = camera:ViewportPointToRay(center)
        origin = ray.Origin
        direction = ray.Direction
    else
        -- Usa a posição do mouse
        local mousePos = Mouse.Position
        local ray = camera:ViewportPointToRay(Vector2.new(mousePos.X, mousePos.Y))
        origin = ray.Origin
        direction = ray.Direction
    end
    
    local params = RaycastParams.new()
    params.FilterDescendantsInstances = {char}
    params.RespectCanCollide = true
    
    local result = workspace:Raycast(origin, direction * CONFIG.RANGE, params)
    
    if result then
        local model = result.Instance:FindFirstAncestorOfClass("Model")
        if model and model:FindFirstChild("Humanoid") then
            if model ~= char then
                if CONFIG.ENEMY_ONLY then
                    if model.Team and LocalPlayer.Team and model.Team == LocalPlayer.Team then
                        return nil
                    end
                end
                return model
            end
        end
    end
    return nil
end

-- LOOP PRINCIPAL
local lastFireTime = 0
local function autoFireLoop()
    while true do
        RunService.Heartbeat:Wait()
        
        if not CONFIG.ENABLED then continue end
        
        local now = tick()
        if now - lastFireTime < CONFIG.FIRE_RATE then continue end
        
        local char = LocalPlayer.Character
        if not char then continue end
        
        local tool = char:FindFirstChildOfClass("Tool")
        if not tool then continue end
        
        local target = getTarget()
        
        if target then
            lastFireTime = now
            forceFire(tool)
        end
    end
end

-- INICIALIZAÇÃO
local gui = createGUI()
task.spawn(autoFireLoop)
print("[AutoFire] Sistema iniciado. Use a GUI no canto direito para ativar/desativar.")
