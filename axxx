-- ============================================================
-- LÓGICA DE DETECÇÃO
-- ============================================================

local function getCharacterFromPart(part)
    -- Sobe na hierarquia para achar o Model que contém o Humanoid
    local current = part
    while current do
        if current:IsA("Model") and current:FindFirstChildOfClass("Humanoid") then
            return current
        end
        current = current.Parent
    end
    return nil
end

local function isEnemy(character)
    if not character or not character.Parent then return false end
    
    local targetPlayer = Players:FindFirstChild(character.Name)
    
    if not targetPlayer then
        return not CONFIG.FRIENDLY_FIRE
    end

    if CONFIG.FRIENDLY_FIRE then return true end

    if CONFIG.TEAM_CHECK and targetPlayer.Team and LocalPlayer.Team then
        if targetPlayer.Team.Name == LocalPlayer.Team.Name then
            return false
        end
    end
    
    return true
end

local function updateDebug(text)
    if CONFIG.SHOW_DEBUG and debugLabel then
        if debugLabel.Text ~= text then
            debugLabel.Text = "Debug: " .. text
        end
    end
end

RunService.RenderStepped:Connect(function()
    if not state.enabled then return end
    
    local character = LocalPlayer.Character
    local camera = workspace.CurrentCamera
    
    if not character or not camera then
        if state.isMouseDown then
            UserInputService:SendMouseInput(Enum.UserInputState.End, Vector2.new(0,0), false)
            state.isMouseDown = false
        end
        updateDebug("No Character/Camera")
        return
    end

    local humanoid = character:FindFirstChild("Humanoid")
    if not humanoid or humanoid.Health <= 0 then
        if state.isMouseDown then
            UserInputService:SendMouseInput(Enum.UserInputState.End, Vector2.new(0,0), false)
            state.isMouseDown = false
        end
        updateDebug("Dead/No Humanoid")
        return
    end

    -- 1. Posição do Mouse
    local mousePos = UserInputService:GetMouseLocation()
    local worldPoint = camera:ViewportPointToWorldSpace(mousePos)
    local rayDirection = camera.CFrame.LookVector * CONFIG.MAX_RANGE
    
    -- 2. Raycast Params
    local params = RaycastParams.new()
    params.FilterDescendantsInstances = {character} -- Ignora o próprio jogador
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.IgnoreWater = true

    local raycastResult = workspace:Raycast(worldPoint, rayDirection, params)
    
    local shouldFire = false
    
    if raycastResult and raycastResult.Instance then
        local hitPart = raycastResult.Instance
        local hitCharacter = getCharacterFromPart(hitPart)
        
        if hitCharacter then
            if isEnemy(hitCharacter) then
                shouldFire = true
                updateDebug("Target: " .. hitCharacter.Name)
            else
                updateDebug("Ally: " .. hitCharacter.Name)
            end
        else
            -- Atingiu algo que não é personagem (parede, chão, etc)
            updateDebug("Blocked: " .. hitPart.Name)
        end
    else
        updateDebug("Empty Space")
    end

    -- 3. Execução do Disparo
    if shouldFire then
        if not state.isMouseDown then
            UserInputService:SendMouseInput(Enum.UserInputState.Begin, Vector2.new(0,0), false)
            state.isMouseDown = true
        end
    else
        if state.isMouseDown then
            UserInputService:SendMouseInput(Enum.UserInputState.End, Vector2.new(0,0), false)
            state.isMouseDown = false
        end
    end
end)

