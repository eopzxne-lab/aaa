-- ==========================================
-- X-RAY ENGINE
-- ==========================================
local function clearXRay()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local char = player.Character
            if char then
                for _, part in ipairs(char:GetDescendants()) do
                    if part:IsA("BasePart") and part:GetAttribute("XRayApplied") then
                        part.Color = part:GetAttribute("OriginalColor") or Color3.new(1,1,1)
                        part.Transparency = part:GetAttribute("OriginalTransparency") or 0
                        part:SetAttribute("XRayApplied", false)
                    end
                end
            end
        end
    end
end

local function updateXRay()
    if not state.xrayActive then return end
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local char = player.Character
            if char then
                for _, part in ipairs(char:GetDescendants()) do
                    if part:IsA("BasePart") and not part:GetAttribute("XRayApplied") then
                        if not part:GetAttribute("OriginalColor") then
                            part:SetAttribute("OriginalColor", part.Color)
                            part:SetAttribute("OriginalTransparency", part.Transparency)
                        end
                        part.Color = CONFIG.XRAY_COLOR
                        part.Transparency = CONFIG.XRAY_TRANSPARENCY
                        part:SetAttribute("XRayApplied", true)
                    end
                end
            end
        end
    end
end

-- ==========================================
-- DETECÇÃO DE ALVO (CENTRO DA TELA)
-- ==========================================
local function getValidTarget()
    if not CONFIG.USE_CENTER_CROSSHAIR then
        local target = Mouse.Target
        if target then
            local model = target:FindFirstAncestorOfClass("Model")
            if model and Players:GetPlayerFromCharacter(model) ~= LocalPlayer then
                local humanoid = model:FindFirstChildOfClass("Humanoid")
                if humanoid and humanoid.Health > 0 then return model end
            end
        end
        return nil
    end

    local viewport = Camera.ViewportSize
    local center = Vector2.new(viewport.X / 2, viewport.Y / 2)
    local ray = Camera:ViewportPointToRay(center.X, center.Y)
    
    local params = RaycastParams.new()
    params.FilterDescendantsInstances = {LocalPlayer.Character}
    params.FilterType = Enum.RaycastFilterType.Exclude
    
    local result = workspace:Raycast(ray.Origin, ray.Direction * 500, params)
    
    if result then
        local model = result.Instance:FindFirstAncestorOfClass("Model")
        if model then
            local targetPlayer = Players:GetPlayerFromCharacter(model)
            if targetPlayer and targetPlayer ~= LocalPlayer then
                local humanoid = model:FindFirstChildOfClass("Humanoid")
                if humanoid and humanoid.Health > 0 then return model end
            end
        end
    end
    return nil
end

-- ==========================================
-- VERIFICAÇÃO DE ESTADO DA ARMA
-- ==========================================
local function isWeaponReady()
    local tool = LocalPlayer:FindFirstChildOfClass("Tool")
    if not tool then return false end
    
    -- 1. Se a Tool estiver embainhada (Sheathed), não atira
    if tool.Sheathed then return false end
    
    -- 2. Verifica atributos comuns de munição/recarga
    -- Muitos scripts usam "Ammo", "Magazine" ou "IsReloading"
    local ammo = tool:GetAttribute("Ammo") or tool:GetAttribute("Magazine") or tool:GetAttribute("CurrentAmmo")
    if ammo ~= nil and ammo <= 0 then
        return false
    end
    
    local isReloading = tool:GetAttribute("IsReloading") or tool:GetAttribute("Reloading")
    if isReloading == true then
        return false
    end
    
    -- 3. Verifica se a Tool tem um ToolTip ou Label indicando recarga (opcional)
    if tool.ToolTip:lower():find("reload") or tool.ToolTip:lower():find("carregando") then
        return false
    end
    
    return true
end

-- ==========================================
-- SISTEMA DE DISPARO (INTELIGENTE)
-- ==========================================
local function executeFire()
    local tool = LocalPlayer:FindFirstChildOfClass("Tool")
    
    if tool then
        -- 1. Tenta ativar a Tool
        tool:Activate()
        
        -- 2. Força a propriedade Activated
        if tool:IsA("Tool") then
            tool.Activated = true
        end
        
        -- 3. Injeta o clique físico
        UserInputService:InjectMouseButton(Enum.UserInputType.MouseButton1, true)
        task.wait(0.005)
        UserInputService:InjectMouseButton(Enum.UserInputType.MouseButton1, false)
        
        -- 4. Marca a arma como "Busy" por um curto período para evitar spam
        -- Isso simula o tempo de animação do disparo
        state.busyUntil = tick() + (CONFIG.FIRE_INTERVAL * 1.5)
    else
        UserInputService:InjectMouseButton(Enum.UserInputType.MouseButton1, true)
        task.wait(0.005)
        UserInputService:InjectMouseButton(Enum.UserInputType.MouseButton1, false)
        state.busyUntil = tick() + (CONFIG.FIRE_INTERVAL * 1.5)
    end
end

-- ==========================================
-- LOOP PRINCIPAL
-- ==========================================
RunService.Heartbeat:Connect(function()
    updateXRay()
    
    if not state.afActive then return end
    
    local char = LocalPlayer.Character
    if not char then return end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then return end
    
    -- Verifica se a arma está pronta
    if not isWeaponReady() then
        -- Se a arma não está pronta, aumenta o intervalo para dar tempo de recarregar
        state.lastFireTime = tick() - (CONFIG.FIRE_INTERVAL - CONFIG.RELOAD_DELAY)
        return
    end
    
    -- Verifica se a arma está "Busy" (recentemente atirou)
    if tick() < state.busyUntil then
        return
    end
    
    local target = getValidTarget()
    
    if target then
        local now = tick()
        if now - state.lastFireTime >= CONFIG.FIRE_INTERVAL then
            executeFire()
            state.lastFireTime = now
        end
    end
end)

print("[AF+XRay] Sistema Inteligente carregado.")
