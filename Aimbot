    def _update_enemies(self):
        """Simula movimento dos inimigos"""
        for enemy in self.enemies:
            # Movimento aleatório suave
            enemy['x'] += random.uniform(-2, 2)
            enemy['y'] += random.uniform(-2, 2)
            
            # Mantém dentro dos limites
            enemy['x'] = max(30, min(550, enemy['x']))
            enemy['y'] = max(30, min(450, enemy['y']))
            
            # Dano simulado
            if random.random() < 0.01:
                enemy['health'] = max(0, enemy['health'] - random.randint(5, 15))
    
    def _draw_scene(self):
        """Desenha a cena no canvas"""
        self.canvas.delete("all")
        
        # Grade de fundo
        for i in range(0, 580, 40):
            self.canvas.create_line(i, 0, i, 280, fill="#1a1a2e", width=1)
            self.canvas.create_line(0, i, 580, i, fill="#1a1a2e", width=1)
        
        # FOV do jogador
        if self.is_active:
            fov_rad = math.radians(self.fov / 2)
            fov_points = []
            for angle in range(-int(self.fov/2), int(self.fov/2) + 1, 5):
                rad = math.radians(angle)
                x = self.player_pos[0] + self.fov_radius * math.cos(rad)
                y = self.player_pos[1] - self.fov_radius * math.sin(rad)
                fov_points.extend([x, y])
            
            if fov_points:
                self.canvas.create_polygon([self.player_pos[0], self.player_pos[1]] + fov_points,
                                          fill="#00d9ff11", outline="#00d9ff", width=1)
        
        # Jogador
        self.canvas.create_oval(self.player_pos[0]-10, self.player_pos[1]-10,
                               self.player_pos[0]+10, self.player_pos[1]+10,
                               fill="#00ff88", outline="#00cc66", width=2)
        self.canvas.create_text(self.player_pos[0], self.player_pos[1]-15, 
                               text="Você", fill="#00ff88", font=("Segoe UI", 8))
        
        # Inimigos
