    def _toggle_aim(self):
        """Ativa/desativa o auto-aim"""
        self.is_active = not self.is_active
        self.active_var.set(self.is_active)
        
        if self.is_active:
            self.status_active.config(text="● ATIVO", fg="#00ff88")
            self.status_bar.config(text=f"Auto-Aim ATIVO | FOV: {self.fov}° | Velocidade: {self.aim_speed:.2f}")
        else:
            self.status_active.config(text="● Inativo", fg="#ff4444")
            self.status_bar.config(text="Auto-Aim INATIVO | Pressione F5 para resetar")
    
    def _update_fov(self, value):
        self.fov = int(float(value))
        self.status_fov.config(text=f"FOV: {self.fov}° | Velocidade: {self.aim_speed:.2f}")
    
    def _update_speed(self, value):
        self.aim_speed = float(value)
        self.status_fov.config(text=f"FOV: {self.fov}° | Velocidade: {self.aim_speed:.2f}")
    
    def _update_min_dist(self, value):
        self.min_distance = int(float(value))
        self.status_dist.config(text=f"Distância: {self.min_distance}-{self.max_distance}m")
    
    def _update_max_dist(self, value):
        self.max_distance = int(float(value))
        self.status_dist.config(text=f"Distância: {self.min_distance}-{self.max_distance}m")
    
    def _update_cooldown(self, value):
        self.fire_cooldown = float(value)
    
    def _update_smooth(self):
        self.smooth_aim = self.smooth_var.get()
    
    def _reset_simulation(self):
        """Reinicia a simulação"""
        self.enemies = self._generate_enemies()
        self.player_pos = (300, 250)
        self.mouse_pos = (300, 250)
        self.target_locked = False
        self.status_target.config(text="Alvo: Nenhum", fg="#aaaaaa")
        self.status_bar.config(text="Simulação reiniciada")
    
    def _find_target(self):
        """Encontra o alvo mais próximo dentro do FOV"""
        if not self.is_active:
            return None
        
        best_target = None
        best_score = float('inf')
        
        for enemy in self.enemies:
            dx = enemy['x'] - self.player_pos[0]
            dy = enemy['y'] - self.player_pos[1]
            distance = math.sqrt(dx**2 + dy**2)
            
            # Verifica distância
            if distance < self.min_distance or distance > self.max_distance:
                continue
            
            # Calcula ângulo relativo
            angle_to_enemy = math.atan2(dy, dx)
            
            # Ângulo do jogador (para a direita)
            player_angle = 0
            
            # Diferença angular normalizada
            angle_diff = abs(angle_to_enemy - player_angle)
            if angle_diff > math.pi:
                angle_diff = 2 * math.pi - angle_diff
            
            # Converte para graus
            angle_deg = math.degrees(angle_diff)
            
            # Verifica FOV
            if angle_deg > self.fov / 2:
                continue
            
            # Score: prioriza distância e FOV
            score = distance / (1 + (self.fov / 2 - angle_deg) / 10)
            
            if score < best_score:
                best_score = score
                best_target = enemy
        
        return best_target
    
    def _update_aim(self):
        """Atualiza a posição da mira"""
        target = self._find_target()
        
        if target:
            if not self.target_locked:
                self.target_locked = True
                self.status_target.config(text=f"Alvo: {target['name']} | HP: {target['health']}", 
                                         fg="#00d9ff")
            
            # Movimento suave da mira
            target_x = target['x']
            target_y = target['y']
            
            if self.smooth_aim:
                dx = target_x - self.mouse_pos[0]
                dy = target_y - self.mouse_pos[1]
                self.mouse_pos = (
                    self.mouse_pos[0] + dx * self.aim_speed,
                    self.mouse_pos[1] + dy * self.aim_speed
                )
            else:
                self.mouse_pos = (target_x, target_y)
            
            # Dispara se estiver no cooldown
            if not hasattr(self, '_last_shot') or time.time() - self._last_shot >= self.fire_cooldown:
                self._fire(target)
                self._last_shot = time.time()
        else:
            if self.target_locked:
                self.target_locked = False
                self.status_target.config(text="Alvo: Nenhum", fg="#aaaaaa")
            # Retorna ao centro
            dx = self.player_pos[0] - self.mouse_pos[0]
            dy = self.player_pos[1] - self.mouse_pos[1]
            self.mouse_pos = (
                self.mouse_pos[0] + dx * 0.1,
                self.mouse_pos[1] + dy * 0.1
            )
    
