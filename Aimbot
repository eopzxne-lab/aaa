class AutoAimSystem:
    def __init__(self, root):
        self.root = root
        self.root.title("Auto-Aim System - Kindo")
        self.root.geometry("600x500")
        self.root.configure(bg="#1a1a2e")
        
        # Variáveis de controle
        self.is_active = False
        self.target_locked = False
        self.aim_speed = 0.15
        self.fov = 120  # Campo de visão em graus
        self.min_distance = 100
        self.max_distance = 1500
        self.fire_cooldown = 0.05
        self.smooth_aim = True
        self.fov_radius = 200
        
        # Posições simuladas
        self.player_pos = (300, 250)
        self.enemies = self._generate_enemies()
        self.mouse_pos = (300, 250)
        
        self._create_ui()
        self._start_update_loop()
        
    def _generate_enemies(self):
        """Gera posições simuladas de inimigos"""
        enemies = []
        for i in range(8):
            enemies.append({
                'id': i,
                'x': random.randint(50, 550),
                'y': random.randint(50, 450),
                'health': random.randint(50, 100),
                'name': f"Enemy_{i}"
            })
        return enemies
    
