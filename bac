-- ==========================================
-- DETECÇÃO DE ALVO (CENTRO DA TELA)
-- ==========================================
local function getValidTarget()
    local char = LocalPlayer.Character
    if not char then return nil end

    if not CONFIG.USE_CENTER_CROSSHAIR then
        local target = Mouse.Target
        if target then
            local model = target:FindFirstAncestorOfClass("Model")
            if model and Players:GetPlayerFromCharacter(model) ~= LocalPlayer then
                local humanoid = model:FindFirstChildOfClass("Humanoid")
                if humanoid and humanoid.Health > 0 then return model end
            end
        end
        return nil
    end

    local viewport = Camera.ViewportSize
    local center = Vector2.new(viewport.X / 2, viewport.Y / 2)
    local ray = Camera:ViewportPointToRay(center.X, center.Y)
    
    local params = RaycastParams.new()
    params.FilterDescendantsInstances = {char}
    params.FilterType = Enum.RaycastFilterType.Exclude
    
    local result = workspace:Raycast(ray.Origin, ray.Direction * 500, params)
    
    if result then
        local model = result.Instance:FindFirstAncestorOfClass("Model")
        if model then
            local targetPlayer = Players:GetPlayerFromCharacter(model)
            if targetPlayer and targetPlayer ~= LocalPlayer then
                local humanoid = model:FindFirstChildOfClass("Humanoid")
                if humanoid and humanoid.Health > 0 then return model end
            end
        end
    end
    return nil
end

-- ==========================================
-- SISTEMA DE DISPARO AVANÇADO
-- ==========================================
local function executeFire(targetModel)
    local char = LocalPlayer.Character
    if not char then return end
    
    local tool = char:FindFirstChildOfClass("Tool")
    if not tool then return end
    
    -- 1. Tenta ativar a ferramenta normalmente
    tool:Activate()
    
    -- 2. Procura por RemoteEvents comuns dentro da arma (muitos jogos exigem isso para registrar o tiro)
    for _, descendant in ipairs(tool:GetDescendants()) do
        if descendant:IsA("RemoteEvent") then
            local nameLower = descendant.Name:lower()
            if nameLower:find("fire") or nameLower:find("shoot") or nameLower:find("hit") or nameLower:find("attack") then
                -- Tenta disparar o evento passando a posição da cabeça ou do alvo
                local targetPart = targetModel:FindFirstChild("Head") or targetModel:FindFirstChild("HumanoidRootPart")
                if targetPart then
                    pcall(function()
                        descendant:FireServer(targetPart.Position)
                    end)
                end
            end
        end
    end
end

-- ==========================================
-- LOOP PRINCIPAL
-- ==========================================
RunService.Heartbeat:Connect(function()
    updateXRay()
    
    if not state.afActive then return end
    
    local char = LocalPlayer.Character
    if not char then return end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then return end
    
    local target = getValidTarget()
    local tool = char:FindFirstChildOfClass("Tool")
    
    if target then
        local now = tick()
        if now - state.lastFireTime >= CONFIG.FIRE_INTERVAL then
            executeFire(target)
            state.lastFireTime = now
        end
    else
        -- Se a mira saiu do personagem, desativa imediatamente a ferramenta para parar de atirar
        if tool then
            pcall(function()
                tool:Deactivate()
            end)
        end
    end
end)

print("[AF+XRay] Sistema atualizado com parada instantânea ao tirar a mira.")
