    end
end)

-- Lógica de Detecção
local function getCharacterFromPart(part)
    if not part then return nil end
    local current = part
    while current and current ~= workspace do
        if current:IsA("Model") then
            if current:FindFirstChildOfClass("Humanoid") or Players:GetPlayerFromCharacter(current) then
                return current
            end
        end
        current = current.Parent
    end
    return nil
end

local function isEnemy(character)
    if not character or not character.Parent then return false end
    local targetPlayer = Players:GetPlayerFromCharacter(character)
    if not targetPlayer then return true end
    if targetPlayer == LocalPlayer then return false end
    if CONFIG.FRIENDLY_FIRE then return true end
    if CONFIG.TEAM_CHECK and targetPlayer.Team and LocalPlayer.Team then
        if targetPlayer.Team == LocalPlayer.Team then return false end
    end
    return true
end

RunService.RenderStepped:Connect(function()
    if not state.enabled then 
        stopFiring()
        return 
    end
    
    local character = LocalPlayer.Character
    local camera = workspace.CurrentCamera
    if not character or not camera then
        stopFiring()
        return
    end

    local humanoid = character:FindFirstChild("Humanoid")
    if not humanoid or humanoid.Health <= 0 then
        stopFiring()
        return
    end

    local viewportSize = camera.ViewportSize
    local centerScreen = Vector2.new(viewportSize.X / 2, viewportSize.Y / 2)
    local unitRay = camera:ViewportPointToRay(centerScreen.X, centerScreen.Y)
    
    local params = RaycastParams.new()
    params.FilterDescendantsInstances = {character}
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.IgnoreWater = true

    local raycastResult = workspace:Raycast(unitRay.Origin, unitRay.Direction * CONFIG.MAX_RANGE, params)
    local shouldFire = false
    
    if raycastResult and raycastResult.Instance then
        local hitPart = raycastResult.Instance
        local hitCharacter = getCharacterFromPart(hitPart)
        if hitCharacter then
            if isEnemy(hitCharacter) then
                shouldFire = true
                debugLabel.Text = "Debug: Target Found"
            else
                debugLabel.Text = "Debug: Ally"
            end
        else
            debugLabel.Text = "Debug: Blocked"
        end
    else
        debugLabel.Text = "Debug: Empty Space"
    end

    if shouldFire then
        startFiring()
    else
        stopFiring()
    end
end)

