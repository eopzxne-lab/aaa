-- Encontra o melhor local protegido para injetar a GUI dependendo do seu executor
local rootGui = nil
local success, err = pcall(function()
    if gethui then
        rootGui = gethui()
    elseif syn and syn.protect_gui then
        local sg = Instance.new("ScreenGui")
        syn.protect_gui(sg)
        rootGui = sg
        sg:Destroy()
    end
end)

if not rootGui then
    local successCore, errCore = pcall(function()
        return CoreGui
    end)
    if successCore and CoreGui then
        rootGui = CoreGui
    else
        rootGui = LocalPlayer:WaitForChild("PlayerGui")
    end
end

-- Remove duplicadas antigas
