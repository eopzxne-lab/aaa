-- Funções de Disparo Contínuo (Metralhadora)
local function startFiring()
    if not state.isFiring then
        state.isFiring = true
        pcall(function()
            if mouse1press then mouse1press()
            elseif pressmouse1 then pressmouse1() end
        end)
    end
end

local function stopFiring()
    if state.isFiring then
        state.isFiring = false
        pcall(function()
            if mouse1release then mouse1release()
            elseif releasemouse1 then releasemouse1() end
        end)
    end
end

