-- ==========================================
-- X-RAY ENGINE
-- ==========================================
local function updateXRay()
    if not state.xrayActive then return end
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local char = player.Character
            if char then
                for _, part in ipairs(char:GetDescendants()) do
                    if part:IsA("BasePart") and not part:GetAttribute("XRayApplied") then
                        -- Salva cor original
                        if not part:GetAttribute("OriginalColor") then
                            part:SetAttribute("OriginalColor", part.Color)
                            part:SetAttribute("OriginalTransparency", part.Transparency)
                        end
                        part.Color = CONFIG.XRAY_COLOR
                        part.Transparency = CONFIG.XRAY_TRANSPARENCY
                        part:SetAttribute("XRayApplied", true)
                    end
                end
            end
        end
    end
end

-- ==========================================
-- FUNÇÃO: OBTER ALVO VÁLIDO
-- ==========================================
local function getValidTarget()
    local target = nil
    
    if CONFIG.USE_CROSSHAIR_CENTER then
        -- Raycast do Centro da Tela (Mira FPS)
        local viewport = Camera.ViewportSize
        local center = Vector2.new(viewport.X / 2, viewport.Y / 2)
        local ray = Camera:ViewportPointToRay(center.X, center.Y)
        
        local params = RaycastParams.new()
        params.FilterDescendantsInstances = {LocalPlayer.Character}
        params.FilterType = Enum.RaycastFilterType.Exclude
        
        local result = workspace:Raycast(ray.Origin, ray.Direction * 500, params)
        if result then
            local model = result.Instance:FindFirstAncestorOfClass("Model")
            if model then
                local targetPlayer = Players:GetPlayerFromCharacter(model)
                if targetPlayer and targetPlayer ~= LocalPlayer then
                    local humanoid = model:FindFirstChildOfClass("Humanoid")
                    if humanoid and humanoid.Health > 0 then
                        target = model
                    end
                end
            end
        end
    else
        -- Fallback: Mouse.Hit
        local model = Mouse.Target:FindFirstAncestorOfClass("Model")
        if model then
            local targetPlayer = Players:GetPlayerFromCharacter(model)
            if targetPlayer and targetPlayer ~= LocalPlayer then
                local humanoid = model:FindFirstChildOfClass("Humanoid")
                if humanoid and humanoid.Health > 0 then
                    target = model
                end
            end
        end
    end
    
    return target
end

-- ==========================================
-- FUNÇÃO: DISPARAR
-- ==========================================
local function executeFire()
    local tool = LocalPlayer:FindFirstChildOfClass("Tool")
    
    if tool then
        -- Método 1: Try Activate (Padrão Roblox)
        if tool:FindFirstChild("Fire") or tool.ClassName == "Tool" then
            tool:Activate()
        end
        
        -- Método 2: Force Activated Property (Para armas que usam a propriedade)
        if tool:GetAttribute("Activated") ~= nil or tool.ClassName == "Tool" then
            tool.Activated = true
        end
        
        -- Método 3: Mouse Injection (Último recurso)
        -- Isso garante que o evento Mouse1Down seja disparado no Client
        UserInputService:InjectMouseButton(Enum.UserInputType.MouseButton1, true)
        task.wait(0.01)
        UserInputService:InjectMouseButton(Enum.UserInputType.MouseButton1, false)
    else
        -- Se não tem tool, injeta clique na tela (para armas que não são tools equipadas)
        UserInputService:InjectMouseButton(Enum.UserInputType.MouseButton1, true)
        task.wait(0.01)
        UserInputService:InjectMouseButton(Enum.UserInputType.MouseButton1, false)
    end
end

-- ==========================================
-- LOOP PRINCIPAL
-- ==========================================
RunService.Heartbeat:Connect(function()
    -- X-Ray Update (Leve)
    updateXRay()
    
    if not state.afActive then return end
    
    local char = LocalPlayer.Character
    if not char then return end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then return end
    
    local target = getValidTarget()
    
    if target then
        local now = tick()
        if now - state.lastFireTime >= CONFIG.FIRE_INTERVAL then
            executeFire()
            state.lastFireTime = now
        end
    end
end)

