        if state.isMouseDown then
            UserInputService:SendMouseInput(Enum.UserInputState.End, Vector2.new(0,0), false)
            state.isMouseDown = false
        end
    end
end)

-- ============================================================
-- LÓGICA DE DETECÇÃO E DISPARO
-- ============================================================

local function isEnemy(character)
    if not character or not character.Parent then return false end
    
    local targetPlayer = Players:FindFirstChild(character.Name)
    
    -- Se for NPC (sem player associado)
    if not targetPlayer then
        return not CONFIG.FRIENDLY_FIRE
    end

    if CONFIG.FRIENDLY_FIRE then return true end

    -- Verificação de Time
    if CONFIG.TEAM_CHECK and targetPlayer.Team and LocalPlayer.Team then
        if targetPlayer.Team.Name == LocalPlayer.Team.Name then
            return false
        end
    end
    
    return true
end

RunService.RenderStepped:Connect(function()
    if not state.enabled then return end
    
    local character = LocalPlayer.Character
    local camera = workspace.CurrentCamera
    
    -- Verificações de segurança
    if not character or not camera then
        if state.isMouseDown then
            UserInputService:SendMouseInput(Enum.UserInputState.End, Vector2.new(0,0), false)
            state.isMouseDown = false
        end
        return
    end

    local humanoid = character:FindFirstChild("Humanoid")
    if not humanoid or humanoid.Health <= 0 then
        if state.isMouseDown then
            UserInputService:SendMouseInput(Enum.UserInputState.End, Vector2.new(0,0), false)
            state.isMouseDown = false
        end
        return
    end

    -- 1. Obtém a posição atual do mouse na tela
    local mousePos = UserInputService:GetMouseLocation()
    
    -- 2. Converte para o espaço do mundo (ponto de origem do raycast)
    local worldPoint = camera:ViewportPointToWorldSpace(mousePos)
    
    -- 3. Define a direção do raio (para frente da câmera)
    local rayDirection = camera.CFrame.LookVector * CONFIG.MAX_RANGE
    
    -- 4. Prepara o Raycast
    local params = RaycastParams.new()
    params.FilterDescendantsInstances = {character} -- Ignora o próprio jogador
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.IgnoreWater = true

    local raycastResult = workspace:Raycast(worldPoint, rayDirection, params)
    
    local shouldFire = false
    
    if raycastResult and raycastResult.Instance then
        local hitPart = raycastResult.Instance
        
        -- Encontra o personagem raiz (Model)
        local hitCharacter = hitPart:FindFirstAncestorOfClass("Model")
        
        if hitCharacter and hitCharacter:FindFirstChild("Humanoid") then
            -- Verifica se é inimigo
            if isEnemy(hitCharacter) then
                shouldFire = true
            end
        end
    end

    -- 5. Executa o Disparo (Mantém o mouse pressionado)
    if shouldFire then
        if not state.isMouseDown then
            -- Inicia o clique virtual
            UserInputService:SendMouseInput(Enum.UserInputState.Begin, Vector2.new(0,0), false)
            state.isMouseDown = true
        end
    else
        if state.isMouseDown then
            -- Solta o clique virtual
            UserInputService:SendMouseInput(Enum.UserInputState.End, Vector2.new(0,0), false)
            state.isMouseDown = false
        end
    end
end)

