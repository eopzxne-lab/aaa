-- LÓGICA DE DISPARO HÍBRIDA
local function forceFire(tool)
    if not tool then return false end
    
    -- 1. Tenta RemoteEvents comuns
    local remoteNames = {"Fire", "Shoot", "Trigger", "FireWeapon", "Ammo_Shot", "ShootBullet"}
    for _, name in ipairs(remoteNames) do
        local rem = tool:FindFirstChild(name)
        if rem and rem:IsA("RemoteEvent") then
            rem:FireServer()
            return true
        end
    end
    
    -- 2. Tenta BindableEvents locais
    local bindableNames = {"Fire", "Shoot", "Trigger"}
    for _, name in ipairs(bindableNames) do
        local bind = tool:FindFirstChild(name)
        if bind and bind:IsA("BindableEvent") then
            bind:Fire()
            return true
        end
    end
    
    -- 3. Fallback: Simula Input via UserInputService
    local camera = workspace.CurrentCamera
    local mousePos = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
    
    UserInputService:FireInput(Enum.UserInputType.MouseButton1, Enum.KeyCode.Unknown, true, false, nil, mousePos)
    task.wait(0.01)
    
    return true
end

-- LÓGICA DE ALVO
local function getTarget()
    local char = LocalPlayer.Character
    if not char then return nil end
    
    local camera = workspace.CurrentCamera
    
    local origin, direction
    if CONFIG.CENTER_CROSSHAIR then
        local center = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
        local ray = camera:ViewportPointToRay(center)
        origin = ray.Origin
        direction = ray.Direction
    else
        local mousePos = LocalPlayer:GetMouse().Position
        local ray = camera:ViewportPointToRay(Vector2.new(mousePos.X, mousePos.Y))
        origin = ray.Origin
        direction = ray.Direction
    end
    
    local params = RaycastParams.new()
    params.FilterDescendantsInstances = {char}
    params.RespectCanCollide = true
    
    local result = workspace:Raycast(origin, direction * CONFIG.RANGE, params)
    
    if result then
        local model = result.Instance:FindFirstAncestorOfClass("Model")
        if model and model:FindFirstChild("Humanoid") then
            if model ~= char then
                if CONFIG.ENEMY_ONLY then
                    if model.Team and LocalPlayer.Team and model.Team == LocalPlayer.Team then
                        return nil
                    end
                end
                return model
            end
        end
    end
    return nil
end

-- LOOP PRINCIPAL
local lastFireTime = 0
local function autoFireLoop()
    while true do
        RunService.Heartbeat:Wait()
        
        if not CONFIG.ENABLED then continue end
        
        local now = tick()
        if now - lastFireTime < CONFIG.FIRE_RATE then continue end
        
        local char = LocalPlayer.Character
        if not char then continue end
        
        local tool = char:FindFirstChildOfClass("Tool")
        if not tool then continue end
        
        local target = getTarget()
        
        if target then
            lastFireTime = now
            forceFire(tool)
        end
    end
end

-- INICIALIZAÇÃO
local guiCreated = false
local tryCreateGUI = function()
    if guiCreated then return end
    pcall(function()
        createGUI()
        guiCreated = true
    end)
    if not guiCreated then
        pcall(function()
            createGUICoreGui()
            guiCreated = true
        end)
    end
    if not guiCreated then
        print("[AutoFire] AVISO: Não foi possível criar a GUI. Use o chat para ativar/desativar.")
        print("[AutoFire] Comandos: 'autofire on', 'autofire off', 'autofire rate 0.02'")
    end
end

task.spawn(function()
    -- Aguarda o PlayerGui estar pronto
    local playerGui = LocalPlayer:WaitForChild("PlayerGui")
    task.wait(1) -- Pequeno delay para garantir que a UI do jogo carregou
    tryCreateGUI()
end)

-- Comando de Chat (Fallback)
LocalPlayer.Chat:Connect(function(message)
    local lowerMsg = message:lower()
    if lowerMsg:sub(1, 8) == "autofire" then
        local args = message:lower():sub(9):split(" ")
        if #args == 0 or args[1] == "on" then
            CONFIG.ENABLED = true
            print("[AutoFire] Ativado.")
        elseif args[1] == "off" then
            CONFIG.ENABLED = false
            print("[AutoFire] Desativado.")
        elseif args[1] == "rate" and args[2] then
            local newRate = tonumber(args[2])
            if newRate and newRate > 0 then
                CONFIG.FIRE_RATE = newRate
                print("[AutoFire] Fire rate ajustado para: " .. newRate)
            end
        elseif args[1] == "center" then
            CONFIG.CENTER_CROSSHAIR = (args[2] ~= "off")
            print("[AutoFire] Center Crosshair: " .. tostring(CONFIG.CENTER_CROSSHAIR))
        else
            print("[AutoFire] Uso: autofire [on|off|rate <n>|center [on|off]]")
        end
    end
end)

task.spawn(autoFireLoop)
print("[AutoFire] Sistema iniciado.")
