-- NÚCLEO DE DISPARO: O "Cérebro"
local function executeFire(tool)
    if not tool then return false end
    
    local fired = false
    
    -- 1. HEURÍSTICA DE REMOTE EVENTS
    -- Procura por nomes que pareçam "tiro"
    local keywords = {"fire", "shoot", "trigger", "ammo", "bullet", "gun", "weapon", "attack", "hit"}
    for _, child in ipairs(tool:GetChildren()) do
        if child:IsA("RemoteEvent") then
            local lowerName = child.Name:lower()
            for _, kw in ipairs(keywords) do
                if lowerName:find(kw) then
                    -- Tenta disparar com argumentos comuns
                    pcall(function()
                        child:FireServer()
                    end)
                    pcall(function()
                        child:FireServer("PrimaryFire")
                    end)
                    fired = true
                    if CONFIG.DEBUG then print("[AutoFire] Disparou Remote: " .. child.Name) end
                end
            end
        end
    end
    
    -- 2. BINDABLE EVENTS LOCAIS
    for _, child in ipairs(tool:GetChildren()) do
        if child:IsA("BindableEvent") then
            local lowerName = child.Name:lower()
            for _, kw in ipairs(keywords) do
                if lowerName:find(kw) then
                    pcall(function()
                        child:Fire()
                    end)
                    fired = true
                    if CONFIG.DEBUG then print("[AutoFire] Disparou Bindable: " .. child.Name) end
                end
            end
        end
    end
    
    -- 3. INJEÇÃO DE INPUT (A MÚLTIPLICADORA DE FORÇA)
    -- Isso força o UserInputService a acreditar que o mouse foi pressionado
    -- Funciona em armas que escutam "UserInputService.InputChanged"
    local camera = workspace.CurrentCamera
    local center = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
    
    -- Simula o "Press"
    UserInputService:FireInput(Enum.UserInputType.MouseButton1, Enum.KeyCode.Unknown, true, false, nil, center)
    
    -- Pequeno delay para o "Release" (opcional, mas ajuda em armas com "auto" nativo)
    task.wait(0.01)
    UserInputService:FireInput(Enum.UserInputType.MouseButton1, Enum.KeyCode.Unknown, false, false, nil, center)
    
    if not fired then
        if CONFIG.DEBUG then print("[AutoFire] Nenhum Remote/Bindable encontrado. Usando Input Injection.") end
    end
    
    return true
end

-- LÓGICA DE ALVO (Otimizada)
local function getTarget()
    local char = LocalPlayer.Character
    if not char then return nil end
    
    local camera = workspace.CurrentCamera
    local origin, direction
    
    if CONFIG.CENTER_CROSSHAIR then
        local center = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
        local ray = camera:ViewportPointToRay(center)
        origin = ray.Origin
        direction = ray.Direction
    else
        local mousePos = Mouse.Position
        local ray = camera:ViewportPointToRay(Vector2.new(mousePos.X, mousePos.Y))
        origin = ray.Origin
        direction = ray.Direction
    end
    
    local params = RaycastParams.new()
    params.FilterDescendantsInstances = {char}
    params.RespectCanCollide = true
    
    local result = workspace:Raycast(origin, direction * CONFIG.RANGE, params)
    
    if result then
        local model = result.Instance:FindFirstAncestorOfClass("Model")
        if model and model:FindFirstChild("Humanoid") then
            if model ~= char then
                if CONFIG.ENEMY_ONLY then
                    if model.Team and LocalPlayer.Team and model.Team == LocalPlayer.Team then
                        return nil
                    end
                end
                return model
            end
        end
    end
    return nil
end

-- LOOP PRINCIPAL
local lastFireTime = 0
local function autoFireLoop()
    while true do
        RunService.Heartbeat:Wait()
        
        if not CONFIG.ENABLED then continue end
        
        local now = tick()
        if now - lastFireTime < CONFIG.FIRE_RATE then continue end
        
        local char = LocalPlayer.Character
        if not char then continue end
        
        local tool = char:FindFirstChildOfClass("Tool")
        if not tool then continue end
        
        local target = getTarget()
        
        if target then
            lastFireTime = now
            executeFire(tool)
        end
    end
end

