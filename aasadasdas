-- CHAT COMMANDS (Backup)
LocalPlayer.Chat:Connect(function(msg)
    local lower = msg:lower()
    if lower:sub(1, 8) == "autofire" then
        local args = lower:sub(9):split(" ")
        if args[1] == "on" then CONFIG.ENABLED = true
        elseif args[1] == "off" then CONFIG.ENABLED = false
        elseif args[1] == "rate" and args[2] then CONFIG.FIRE_RATE = tonumber(args[2]) or 0.05
        elseif args[1] == "debug" then CONFIG.DEBUG = not CONFIG.DEBUG
        else print("[AutoFire] Uso: autofire [on|off|rate <n>|debug]") end
        print("[AutoFire] Status: " .. tostring(CONFIG.ENABLED) .. " | Rate: " .. CONFIG.FIRE_RATE)
    end
end)

task.spawn(autoFireLoop)
