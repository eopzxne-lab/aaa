-- LÓGICA DE ALVO
local function getTarget()
    local char = LocalPlayer.Character
    if not char then return nil end
    
    local camera = workspace.CurrentCamera
    local origin, direction
    
    if CONFIG.CENTER_CROSSHAIR then
        local center = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
        local ray = camera:ViewportPointToRay(center)
        origin = ray.Origin
        direction = ray.Direction
    else
        local mousePos = Mouse.Position
        local ray = camera:ViewportPointToRay(Vector2.new(mousePos.X, mousePos.Y))
        origin = ray.Origin
        direction = ray.Direction
    end
    
    local params = RaycastParams.new()
    params.FilterDescendantsInstances = {char}
    params.RespectCanCollide = true
    
    local result = workspace:Raycast(origin, direction * CONFIG.RANGE, params)
    
    if result then
        local model = result.Instance:FindFirstAncestorOfClass("Model")
        if model and model:FindFirstChild("Humanoid") then
            if model ~= char then
                if CONFIG.ENEMY_ONLY then
                    if model.Team and LocalPlayer.Team and model.Team == LocalPlayer.Team then
                        return nil
                    end
                end
                return model
            end
        end
    end
    return nil
end

-- NÚCLEO DE DISPARO: INPUT INJECTION
local function executeFire(tool)
    if not tool then return false end
    
    -- 1. Tenta RemoteEvents comuns (Fallback)
    local remoteNames = {"Fire", "Shoot", "Trigger", "FireWeapon", "Ammo_Shot"}
    for _, name in ipairs(remoteNames) do
        local rem = tool:FindFirstChild(name)
        if rem and rem:IsA("RemoteEvent") then
            rem:FireServer()
            return true
        end
    end
    
    -- 2. INPUT INJECTION (A MÚLTIPLICADORA DE FORÇA)
    -- Isso força o UserInputService a acreditar que o mouse foi pressionado
    local camera = workspace.CurrentCamera
    local center = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
    
    -- Simula o "Press"
    UserInputService:FireInput(Enum.UserInputType.MouseButton1, Enum.KeyCode.Unknown, true, false, nil, center)
    
    -- Pequeno delay para garantir que o evento seja processado
    task.wait(0.01)
    
    -- Simula o "Release" (opcional, mas ajuda em armas com "auto" nativo)
    UserInputService:FireInput(Enum.UserInputType.MouseButton1, Enum.KeyCode.Unknown, false, false, nil, center)
    
    return true
end

-- LOOP PRINCIPAL
local lastFireTime = 0
local function autoFireLoop()
    while true do
        RunService.Heartbeat:Wait()
        
        if not CONFIG.ENABLED then continue end
        
        local now = tick()
        if now - lastFireTime < CONFIG.FIRE_RATE then continue end
        
        local char = LocalPlayer.Character
        if not char then continue end
        
        local tool = char:FindFirstChildOfClass("Tool")
        if not tool then continue end
        
        local target = getTarget()
        
        if target then
            lastFireTime = now
            executeFire(tool)
            
            if CONFIG.DEBUG then
                print("[AutoFire] Disparou em: " .. target.Name)
            end
        end
    end
end

