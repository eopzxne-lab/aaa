-- ==========================================
-- SISTEMA DE OCULTAR GUI POR TECLA
-- ==========================================
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if input.KeyCode == CONFIG.TOGGLE_KEY then
        state.guiVisible = not state.guiVisible
        mainFrame.Visible = state.guiVisible
    end
end)

-- ==========================================
-- BOTÃO DE EVENTOS (AUTO FIRE)
-- ==========================================
btnAF.MouseButton1Click:Connect(function()
    state.afActive = not state.afActive
    if state.afActive then
        btnAF.Text = "🔫 AF: ON"
        btnAF.BackgroundColor3 = Color3.fromRGB(34, 197, 94)
        btnAF.TextColor3 = Color3.fromRGB(255, 255, 255)
    else
        btnAF.Text = "🔫 AF: OFF"
        btnAF.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
        btnAF.TextColor3 = Color3.fromRGB(200, 200, 210)
        state.isFiring = false
        pcall(function()
            VirtualUser:Button1Up(Vector2.new(0,0))
        end)
    end
end)

-- ==========================================
-- DETECÇÃO DE ALVO VIA MOUSE.TARGET
-- ==========================================
local function getValidTarget()
    local targetPart = Mouse.Target
    if not targetPart then return nil end
    
    local model = targetPart.FindFirstAncestorOfClass(targetPart, "Model")
    if not model then return nil end
    
    local targetPlayer = Players:GetPlayerFromCharacter(model)
    if targetPlayer and targetPlayer ~= LocalPlayer then
        local humanoid = model:FindFirstChildOfClass("Humanoid")
        if humanoid and humanoid.Health > 0 then
            local char = LocalPlayer.Character
            if char and char:FindFirstChild("HumanoidRootPart") and model:FindFirstChild("HumanoidRootPart") then
                local dist = (char.HumanoidRootPart.Position - model.HumanoidRootPart.Position).Magnitude
                if dist <= CONFIG.MAX_DISTANCE then
                    return model
                end
            end
        end
    end
    return nil
end

-- ==========================================
-- LOOP PRINCIPAL DE CONTROLE (HEARTBEAT - RAJADA)
-- ==========================================
RunService.Heartbeat:Connect(function()
    if not state.afActive then return end
    
    local char = LocalPlayer.Character
    if not char then return end
    
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then 
        if state.isFiring then
            state.isFiring = false
            pcall(function() VirtualUser:Button1Up(Vector2.new(0,0)) end)
        end
        return 
    end
    
    local tool = char:FindFirstChildOfClass("Tool")
    if not tool then
        if state.isFiring then
            state.isFiring = false
            pcall(function() VirtualUser:Button1Up(Vector2.new(0,0)) end)
        end
        return
    end
    
    local target = getValidTarget()
    local now = tick()
    
    if target then
        if not state.isFiring then
            state.isFiring = true
            state.lastFireTime = now
            pcall(function()
                VirtualUser:Button1Down(Vector2.new(0,0))
            end)
        else
            if (now - state.lastFireTime >= CONFIG.FIRE_DELAY) then
                state.lastFireTime = now
                pcall(function()
                    VirtualUser:Button1Up(Vector2.new(0,0))
                    task.defer(function()
                        if state.afActive and state.isFiring then
                            VirtualUser:Button1Down(Vector2.new(0,0))
                        end
                    end)
                end)
            end
        end
    else
        if state.isFiring then
            state.isFiring = false
            pcall(function()
                VirtualUser:Button1Up(Vector2.new(0,0))
            end)
        end
    end
end)

print("[Auto Fire] Carregado com Sucesso! Pressione RightControl para esconder/mostrar a GUI.")
