-- ==========================================
-- DETECÇÃO DE ALVO (ROBUSTA)
-- ==========================================
local function getValidTarget()
    local char = LocalPlayer.Character
    if not char then return nil end

    -- Raycast Params: Filtra o próprio jogador
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {char}
    
    -- Define o ponto de mira (Centro da tela ou Mouse)
    local center
    if CONFIG.USE_CENTER_CROSSHAIR then
        center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    else
        center = Mouse.Location
    end

    local ray = Camera:ViewportPointToRay(center.X, center.Y)
    local result = workspace:Raycast(ray.Origin, ray.Direction * CONFIG.MAX_RANGE, params)
    
    if result then
        local instance = result.Instance
        local model = instance:FindFirstAncestorOfClass("Model")
        
        if model then
            local targetPlayer = Players:GetPlayerFromCharacter(model)
            if targetPlayer and targetPlayer ~= LocalPlayer then
                local humanoid = model:FindFirstChildOfClass("Humanoid")
                if humanoid and humanoid.Health > 0 then
                    return model
                end
            end
        end
    end
    return nil
end

-- ==========================================
-- SISTEMA DE DISPARO AVANÇADO
-- ==========================================
local function executeFire(targetModel)
    local char = LocalPlayer.Character
    if not char then return false end
    
    local tool = char:FindFirstChildOfClass("Tool")
    if not tool then return false end

    -- 1. Dispara o evento de RemoteEvent se existir (muitos jogos usam isso)
    for _, descendant in ipairs(tool:GetDescendants()) do
        if descendant:IsA("RemoteEvent") then
            local nameLower = descendant.Name:lower()
            if nameLower:find("fire") or nameLower:find("shoot") or nameLower:find("hit") or nameLower:find("attack") then
                local targetPart = targetModel:FindFirstChild("Head") or targetModel:FindFirstChild("HumanoidRootPart")
                if targetPart then
                    pcall(function()
                        descendant:FireServer(targetPart.Position)
                    end)
                end
            end
        end
    end

    -- 2. Ativa a ferramenta (Método padrão)
    pcall(function()
        tool:Activate()
    end)

    return true
end

-- ==========================================
-- LOOP PRINCIPAL (LÓGICA DE PARADA/INÍCIO)
-- ==========================================
RunService.Heartbeat:Connect(function()
    updateXRay()
    
    if not state.afActive then
        state.isAutoFiring = false
        return
    end
    
    local char = LocalPlayer.Character
    if not char then return end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then
        state.isAutoFiring = false
        return
    end

    -- Verifica se o usuário está segurando o mouse manualmente
    local isMouseHeld = UserInputService:IsKeyDown(Enum.UserInputType.MouseButton1)
    
    local currentTarget = getValidTarget()
    
    -- ==========================================
    -- LÓGICA CRÍTICA: PARADA E RETOMADA
    -- ==========================================
    
    if currentTarget then
        -- MIRA NO ALVO: PREPARA PARA ATIRAR
        state.lastValidTarget = currentTarget
        
        if not isMouseHeld then
            local now = tick()
            if now - state.lastFireTime >= CONFIG.FIRE_INTERVAL then
                if executeFire(currentTarget) then
                    state.lastFireTime = now
                    state.isAutoFiring = true
                end
            end
        else
            -- Se o usuário segurar o mouse, o AF cede o controle
            state.isAutoFiring = false
        end
    else
        -- MIRA FORA DO ALVO: PARA IMEDIATAMENTE
        state.lastValidTarget = nil
        state.isAutoFiring = false
        state.lastFireTime = 0 -- Reset para atirar instantaneamente se voltar
    end
end)

