-- ==========================================
-- DETECÇÃO DE ALVO (ESTRITA)
-- ==========================================
local function getValidTarget()
    local char = LocalPlayer.Character
    if not char then return nil end

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    -- Filtra apenas o personagem local para não atirar em si mesmo
    params.FilterDescendantsInstances = {char}
    
    local ray
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    ray = Camera:ViewportPointToRay(center.X, center.Y)
    
    local result = workspace:Raycast(ray.Origin, ray.Direction * CONFIG.MAX_RANGE, params)
    
    if result then
        local instance = result.Instance
        -- Verifica se a parte atingida pertence a um Modelo (Personagem)
        local model = instance:FindFirstAncestorOfClass("Model")
        if model then
            local targetPlayer = Players:GetPlayerFromCharacter(model)
            if targetPlayer and targetPlayer ~= LocalPlayer then
                local humanoid = model:FindFirstChildOfClass("Humanoid")
                -- Verifica se está vivo e não é um NPC/Prop
                if humanoid and humanoid.Health > 0 and humanoid.WalkSpeed ~= 0 then
                    return model
                end
            end
        end
    end
    return nil
end

-- ==========================================
-- SISTEMA DE DISPARO
-- ==========================================
local function executeFire(targetModel)
    local char = LocalPlayer.Character
    if not char then return false end
    
    local tool = char:FindFirstChildOfClass("Tool")
    if not tool then return false end

    -- Verifica se a ferramenta está disponível (não em cooldown de recarga interna)
    if tool:GetAttribute("AF_Cooldown") then
        return false
    end

    tool:SetAttribute("AF_Cooldown", true)
    
    local success = pcall(function()
        -- 1. Ativação Principal
        tool:Activate()
        
        -- 2. Fallback: RemoteEvents específicos
        for _, descendant in ipairs(tool:GetDescendants()) do
            if descendant:IsA("RemoteEvent") then
                local nameLower = descendant.Name:lower()
                if nameLower:find("fire") or nameLower:find("shoot") or nameLower:find("hit") or nameLower:find("attack") then
                    local targetPart = targetModel:FindFirstChild("Head") or targetModel:FindFirstChild("HumanoidRootPart")
                    if targetPart then
                        pcall(function()
                            descendant:FireServer(targetPart.Position)
                        end)
                    end
                end
            end
        end
    end)

    -- Libera o cooldown imediatamente para permitir o próximo frame
    task.defer(function()
        if tool then
            tool:SetAttribute("AF_Cooldown", false)
        end
    end)

    return success
end

-- ==========================================
-- LOOP PRINCIPAL CORRIGIDO
-- ==========================================
RunService.Heartbeat:Connect(function()
    updateXRay()
    
    if not state.afActive then
        state.isAutoFiring = false
        return
    end
    
    local char = LocalPlayer.Character
    if not char then return end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then
        state.isAutoFiring = false
        return
    end

    -- Verifica se o usuário está segurando o mouse manualmente
    local isMouseHeld = UserInputService:IsKeyDown(Enum.UserInputType.MouseButton1)
    
    local target = getValidTarget()
    
    -- LÓGICA CRÍTICA: SE NÃO HÁ ALVO, PARA IMEDIATAMENTE
    if not target then
        state.isAutoFiring = false
        state.lastFireTime = 0 -- Reset para disparar instantaneamente se o alvo voltar
        return
    end

    -- Se há alvo, mas o usuário está segurando o mouse, não interfere
    if isMouseHeld then
        state.isAutoFiring = false
        return
    end

    -- Se há alvo e o mouse não está sendo segurado, dispara
    local now = tick()
    if now - state.lastFireTime >= CONFIG.FIRE_INTERVAL then
        if executeFire(target) then
            state.lastFireTime = now
            state.isAutoFiring = true
        end
    end
end)

